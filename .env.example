# 高德 Web 服务 Key（必填）
AMAP_API_KEY=

# 高德 Web端(JS API) Key（前端地图用，可选）
AMAP_JS_KEY=

# 高德 JS API 安全密钥 securityJsCode（与 JS Key 配套，可选）
AMAP_JS_SECURITY_CODE=

# LLM 提供商（可选，默认 "deepseek"，支持 "openai"、"grok"、"deepseek"、"doubao"）
# LLM_PROVIDER=openai

# OpenAI API Key（如果使用 OpenAI 提供商，此项必填）
OPENAI_API_KEY=

# OpenAI 模型与推理强度（可选）
# OPENAI_MODEL=gpt-5.6-terra
# TRAVELMIND_OPENAI_REASONING_EFFORT=none

# Grok/xAI OpenAI 兼容接口（如果使用 Grok 提供商，此项必填）
# 官方 xAI 通常使用 https://api.x.ai/v1；Grok CLI 中转请复制 config.toml 的 base URL
# GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-4.6
# GROK_USE_RESPONSES_API=1
# GROK_REASONING_EFFORT=low
# 单次请求超时与客户端重试。第三方中转建议优先 chat/completions、关闭自动重试，
# 避免一个节点耗尽整条 Agent 工作流的时间预算。
# GROK_REQUEST_TIMEOUT_SECONDS=45
# GROK_MAX_RETRIES=0

# DeepSeek API Key（如果使用 DeepSeek 提供商，此项必填）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包 API Key（如果使用豆包提供商，此项必填）
# DOUBAO_API_KEY=

# 豆包模型（可选，默认 doubao-pro-4k）
# DOUBAO_MODEL=doubao-pro-4k

# 可选模型路由（默认关闭）：短任务使用同一提供商下的小模型，
# Planner / Reviewer / Judge 等复杂任务继续使用上方配置的主模型。
# 启用前必须确认 LLM_SMALL_MODEL 是当前 LLM_PROVIDER 可访问的模型名。
LLM_ROUTING_ENABLED=0
# LLM_SMALL_MODEL=
# LLM_ROUTING_SHORT_TOKEN_THRESHOLD=1200

# Redis 缓存（可选，不配置则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# 单次 Agent 规划最大执行时间（秒，范围 5-900）
PLAN_TIMEOUT_SECONDS=180

# LLM 成本估算单价（美元/千 token）。不同模型价格不同，请按当前供应商账单填写；
# 不填写时仍统计 token 与延迟，但估算成本保持 0，避免使用过期硬编码价格。
LLM_INPUT_USD_PER_1K=0
LLM_OUTPUT_USD_PER_1K=0

# 首次 Chroma 语义记忆检索的最大等待时间（秒）
MEMORY_LOOKUP_TIMEOUT_SECONDS=2.5

# Docker 首次运行默认关闭 embedding 模型下载；需要完整 Chroma 检索时改为 1
SEMANTIC_MEMORY_ENABLED=0
TRAVEL_KNOWLEDGE_ENABLED=0

# HTTP 代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

# LangSmith 追踪（可选，接入后可在 smith.langchain.com 查看 Agent 链路）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__你的key
# LANGCHAIN_PROJECT=floattrip-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
